# Variáveis de Ambiente Opcionais (Expo Public Environment Variables)
# Por padrão, o aplicativo já possui fallbacks seguros e funciona 100% sem nenhum arquivo .env.

# Chave PIX voluntária exibida na seção de apoio (Padrão: figueiredogonzalez@live.com)
EXPO_PUBLIC_PIX_KEY=figueiredogonzalez@live.com

# Link para apoio internacional via Buy Me a Coffee (Opcional)
EXPO_PUBLIC_BMC_URL=https://buymeacoffee.com/philipe.gonzalez

# Resend API Key para envio de e-mails instantâneos do formulário de feedback (Opcional)
# Obtenha uma chave gratuita em: https://resend.com/api-keys
EXPO_PUBLIC_RESEND_API_KEY=

# E-mail de destino para recebimento dos relatos e pareceres de médicos/usuários
EXPO_PUBLIC_FEEDBACK_TARGET_EMAIL=philipe.e.f.gonzalez@gmail.com
